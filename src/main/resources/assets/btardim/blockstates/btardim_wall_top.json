{
  "multipart": [
    {
      "apply":{
        "model": "btardim:block/btardim_wall_top"
      },
      "when": {
        "side": "north"
      }
    },
    {
      "apply":{
        "model": "btardim:block/btardim_wall_top_south"
      },
      "when": {
        "side": "south"
      }
    },
    {
      "apply":{
        "model": "btardim:block/btardim_wall_top_east"
      },
      "when": {
        "side": "east"
      }
    },
    {
      "apply":{
        "model": "btardim:block/btardim_wall_top_west"
      },
      "when": {
        "side": "west"
      }
    }
  ]
}
